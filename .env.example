# Public site URL. Production must use HTTPS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# At least 32 random characters. Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_PASSWORD=

# Vercel KV / compatible Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin login (there are deliberately no code defaults)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Registration email
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=DataStore <noreply@example.com>
EMAIL_TLS_REJECT_UNAUTHORIZED=true
ALLOWED_EMAIL_DOMAINS=gmail.com,qq.com,outlook.com,163.com,hotmail.com

# WeChat Pay API v3. Enable each payment product in the merchant platform;
# adding environment variables cannot grant H5 / JSAPI / Native permissions.
WX_APP_ID=
# Official Account OAuth only (JSAPI in WeChat). Not required for H5 / Native.
# Must belong to the same Official Account as WX_APP_ID.
WX_APP_SECRET=
WX_MCH_ID=
WX_API_V3_KEY=
# Store PEM line breaks as \n when the platform only accepts one line.
WX_CERT=
WX_KEY=

# Alipay (public-key mode). Sign 电脑网站支付 and 手机网站支付 in the Alipay
# open platform; the admin 支付 tab decides whether the method is shown.
ALIPAY_APP_ID=
# 应用私钥, PKCS1 or PKCS8, with or without PEM armor. "\n" escapes are fine.
ALIPAY_PRIVATE_KEY=
# 支付宝公钥 (not the 应用公钥).
ALIPAY_PUBLIC_KEY=
# Optional: your 2088... PID; notifications for another seller are rejected.
ALIPAY_SELLER_ID=
# Optional: sandbox is https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=

# Non-custodial BSC USDT. Enable in admin only after starting the scanner.
# HTTPS RPC endpoints MUST support eth_getLogs and eth_getTransactionReceipt.
# API-key-bearing URLs are server-only; configure these in deployment settings.
BSC_RPC_URL=
BSC_RPC_URL_BACKUP=
# Binance-Peg USDT, verified via BNB Chain asset mapping (see docs/USDT-BSC.md).
BSC_USDT_CONTRACT=0x55d398326f99059ff775485246999027b3197955
# Public receiving address ONLY. Never put wallet secrets in this application.
BSC_PAYMENT_ADDRESS=
BSC_CONFIRMATIONS=20
USDT_PAYMENT_TIMEOUT_MINUTES=15
# Required explicit quote: CNY per 1 USDT (not an automatically fetched FX rate).
USDT_CNY_RATE=
# Permanent, non-recycled six-decimal tails; max surcharge defaults to 0.009999.
USDT_TAIL_MAX=9999
# Random >=32-character bearer secret for GET/POST /api/usdt/scan.
CRON_SECRET=
