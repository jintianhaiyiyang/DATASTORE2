# Public site URL. Production must use HTTPS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# At least 32 random characters. Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_PASSWORD=

# Vercel KV / compatible Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Admin login (there are deliberately no code defaults)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Registration email
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=DataStore <noreply@example.com>
EMAIL_TLS_REJECT_UNAUTHORIZED=true
ALLOWED_EMAIL_DOMAINS=gmail.com,qq.com,outlook.com,163.com,hotmail.com

# WeChat Pay API v3 / Official Account OAuth
WX_APP_ID=
WX_APP_SECRET=
WX_MCH_ID=
WX_API_V3_KEY=
# Store PEM line breaks as \n when the platform only accepts one line.
WX_CERT=
WX_KEY=
